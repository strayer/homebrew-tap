{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": ["dependencies"],
  // sketchybar is pinned to a patched fork commit until the fix lands upstream.
  // claude-code-statusline installs per-platform release binaries, which the
  // homebrew manager can't bump (it only rewrites source tarball urls).
  "ignorePaths": ["Formula/sketchybar.rb", "Formula/claude-code-statusline.rb"],
  // Formula bumps (Renovate's homebrew manager rewrites url + sha256 from the new
  // release tag) and action digests are the only updates here; `brew audit` in CI
  // is the gate, so they merge on their own once green.
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "rebase",
  "platformAutomerge": true
}
